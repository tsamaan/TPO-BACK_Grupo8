# Archivo de ejemplo de variables de entorno para desarrollo local
# Copia este archivo como .env y ajusta los valores según necesites

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/haversack_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=haversack
SPRING_DATASOURCE_PASSWORD=haversackpass

# JPA Configuration
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# MySQL Root Password (solo para Docker)
MYSQL_ROOT_PASSWORD=rootpassword

# Security
SPRING_SECURITY_USER_NAME=admin
SPRING_SECURITY_USER_PASSWORD=admin123

# JWT Configuration
JWT_SECRET=haversack-secret-key-for-jwt-token-generation-must-be-at-least-256-bits-long-and-secure
JWT_EXPIRATION=86400000

# Server
SERVER_PORT=8080

# Timezone
TZ=UTC
